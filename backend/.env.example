# ──────────────────────────────────────────────────────────────
# PrivacyLens Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is already in .gitignore.
# ──────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard → Connect → Drivers → Python
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_URI=

# MongoDB database name (default: privacylens)
DB_NAME=privacylens

# Gemini API key (Person 2 sets this — you can share via Notion / team secret)
GEMINI_API_KEY=

# OpenAI API key (optional Gemini fallback)
OPENAI_API_KEY=

# (Optional) Your deployed Vercel frontend URL for CORS
FRONTEND_URL=https://your-leaderboard.vercel.app

# (Optional) Port for local uvicorn server
PORT=8000
